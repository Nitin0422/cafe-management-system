<% content_for :title, "New staff account" %>

<h1>New staff account</h1>

<%= form_with model: @user, url: admin_users_path do |form| %>
  <% if @user.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :full_name, "Full name" %>
    <%= form.text_field :full_name, autofocus: true %>
  </div>

  <div>
    <%= form.label :email, "Email" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Password" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :role, "Role" %>
    <%= form.select :role, options_for_select([["Staff", "staff"], ["Admin", "admin"]]) %>
  </div>

  <%= form.submit "Create staff account" %>
<% end %>
