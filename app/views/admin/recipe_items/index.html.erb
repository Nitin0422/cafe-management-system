<% content_for :title, "Recipes" %>

<h1>Recipes</h1>

<p><%= link_to "Add recipe line", new_admin_recipe_item_path %></p>

<table>
  <thead>
    <tr>
      <th>Menu item</th>
      <th>Ingredient</th>
      <th>Quantity</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @recipe_items.each do |recipe_item| %>
      <tr>
        <td><%= recipe_item.menu_item.name %></td>
        <td><%= recipe_item.ingredient.name %></td>
        <td><%= recipe_item.quantity %> <%= recipe_item.ingredient.unit %></td>
        <td>
          <%= link_to "Edit", edit_admin_recipe_item_path(recipe_item) %>
          <%= button_to "Remove", admin_recipe_item_path(recipe_item), method: :delete, class: "btn btn--danger",
                        data: { turbo_confirm: "Remove this ingredient from the recipe?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
